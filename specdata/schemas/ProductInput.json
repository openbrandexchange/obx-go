{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbrandexchange.com/schemas/v0.3/ProductInput.json",
  "type": "object",
  "title": "ProductInput",
  "description": "Ingest write model for a product. Key: external_id (path); when a brand has no separate product id, use the style number.",
  "properties": {
    "brand_external_id": {
      "anyOf": [
        {
          "$ref": "Common.json#/$defs/ExternalId",
          "description": "Required unless the node has exactly one brand."
        },
        {
          "type": "null"
        }
      ]
    },
    "style_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "$ref": "LocalizedText.json"
    },
    "description": {
      "anyOf": [
        {
          "$ref": "LocalizedText.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "item_type": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "item_subtype": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "gpc_brick": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{8}$"
    },
    "target_group": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "season": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "collection": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "Collection name as the brand writes it (informative). Membership of a collection release record is by `collection_external_id` (proposal 0006)."
    },
    "collection_external_id": {
      "anyOf": [
        {
          "$ref": "Common.json#/$defs/ExternalId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Proposal 0006: the external id of the collection release record its colours belong to. A variant's own `collection_external_id` overrides it for that variant's colour. A value without a record holds nothing (the record may come later). null or absent: in no collection."
    },
    "materials": {
      "anyOf": [
        {
          "$ref": "Materials.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "contains_animal_origin": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "footwear_materials": {
      "anyOf": [
        {
          "$ref": "FootwearMaterials.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "care": {
      "anyOf": [
        {
          "$ref": "Care.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "country_of_origin": {
      "anyOf": [
        {
          "$ref": "Common.json#/$defs/CountryCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "certifications": {
      "anyOf": [
        {
          "$ref": "Certifications.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "dpp_url": {
      "anyOf": [
        {
          "$ref": "Common.json#/$defs/Url"
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "anyOf": [
        {
          "$ref": "Features.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "attributes": {
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "$ref": "LocalizedText.json"
          }
        ]
      }
    },
    "status": {
      "$ref": "Common.json#/$defs/PublicationStatus"
    }
  },
  "required": [
    "style_number",
    "name"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9]+-[a-z0-9_-]+$": true
  }
}
